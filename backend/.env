# ============================================================
# ThirdVizion RAG Backend — environment configuration
# Backend loads this file from: backend/.env
# All values below match the previous hardcoded defaults,
# so existing behaviour (including the frontend on :5173
# calling the API on :8000) is unchanged.
# ============================================================

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Frontend (CORS) ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Paths ---
# Relative paths are resolved against the project root
# (local-rag-app/). Absolute paths are used as-is.
CHROMA_DIR=chroma_db
DOCUMENTS_DIR=documents

# --- Models ---
COLLECTION_NAME=thirdvizion
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# --- Chunking / retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
